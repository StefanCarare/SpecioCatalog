__pycache__/
*.pyc

# per-machine: holds the absolute path to the Specio Identify folder
config/settings.txt

# generated from the catalogue at runtime; rebuilds itself on first run.
# It lists every species in the user's own catalogue, so it stays out of git.
cache/

logs/

